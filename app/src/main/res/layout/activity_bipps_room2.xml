<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="BippRoom2_2.BippsRoom2">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="31dp"
        android:text="Rooms"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="59dp"></LinearLayout>

    <EditText
        android:id="@+id/editTextText"
        android:layout_width="399dp"
        android:layout_height="48dp"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        tools:layout_editor_absoluteX="13dp"
        tools:layout_editor_absoluteY="87dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextText3"
        />

    <EditText
        android:id="@+id/editTextText6"
        android:layout_width="390dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="text"
        android:text="RoomNumber"
        tools:layout_editor_absoluteX="12dp"
        tools:layout_editor_absoluteY="155dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextText"
        />

    <EditText
        android:id="@+id/editTextText7"
        android:layout_width="382dp"
        android:layout_height="46dp"
        android:ems="10"
        android:inputType="text"
        android:text="buildingName"
        tools:layout_editor_absoluteX="18dp"
        tools:layout_editor_absoluteY="212dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextText6"
        />

    <EditText
        android:id="@+id/editTextText8"
        android:layout_width="390dp"
        android:layout_height="60dp"
        android:ems="10"
        android:inputType="text"
        android:text="newStartTime"
        tools:layout_editor_absoluteX="15dp"
        tools:layout_editor_absoluteY="265dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextText7"
        />

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accept"
        tools:layout_editor_absoluteX="141dp"
        tools:layout_editor_absoluteY="404dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editTextText8"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
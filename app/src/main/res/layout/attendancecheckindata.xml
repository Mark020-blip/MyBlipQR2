<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Form Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Attendance Check-In Form"
            android:textColor="#1E88E5"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Full Name Input -->
        <EditText
            android:id="@+id/StudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Enter Full Name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:textSize="16sp" />

        <!-- Student ID Input -->
        <EditText
            android:id="@+id/StudentID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Enter Student ID"
            android:inputType="text"
            android:padding="14dp"
            android:textSize="16sp" />

        <!-- Major / Course Input -->
        <EditText
            android:id="@+id/Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Enter Section"
            android:inputType="text"
            android:padding="14dp"
            android:textSize="16sp" />

        <!-- Date Input -->
        <EditText
            android:id="@+id/Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Enter Date"
            android:inputType="date"
            android:padding="14dp"
            android:textSize="16sp" />

        <!-- Check-In Time Input -->
        <EditText
            android:id="@+id/CheckInTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Enter Check-In Time"
            android:inputType="time"
            android:padding="14dp"
            android:textSize="16sp" />

        <!-- Attendance Status Input -->
        <EditText
            android:id="@+id/AttendanceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Enter Attendance (present, absent, late)"
            android:inputType="text"
            android:padding="14dp"
            android:textSize="16sp" />


        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitCheckIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E88E5"
            android:padding="14dp"
            android:text="SUBMIT CHECK-IN"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>